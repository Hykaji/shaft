# Nunca coloque o token diretamente no código ou no navegador.
NOTION_API_KEY=cole_aqui_o_token_da_integracao_privada

# Configure ao menos uma lista no ambiente hospedado. Use vírgulas para mais
# de um proprietário e nunca coloque valores reais neste arquivo de exemplo.
SHAFT_ALLOWED_USER_IDS=
SHAFT_ALLOWED_USER_EMAILS=
