      "checkConstraints": {
        "checkin_ledger_date_check": {
          "name": "checkin_ledger_date_check",
          "value": "length(\"checkin_ledger\".\"checkin_date\") = 10 AND \"checkin_ledger\".\"checkin_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "checkin_ledger_payload_version_check": {
          "name": "checkin_ledger_payload_version_check",
          "value": "\"checkin_ledger\".\"payload_version\" >= 1"
        },
        "checkin_ledger_payload_fingerprint_check": {
          "name": "checkin_ledger_payload_fingerprint_check",
          "value": "length(\"checkin_ledger\".\"payload_fingerprint\") = 64"
        },
        "checkin_ledger_payload_json_check": {
          "name": "checkin_ledger_payload_json_check",
          "value": "json_valid(\"checkin_ledger\".\"payload_json\")"
        },
        "checkin_ledger_day_type_check": {
          "name": "checkin_ledger_day_type_check",
          "value": "\"checkin_ledger\".\"day_type\" IN ('Trabalho', 'Folga', 'Férias')"
        },
        "checkin_ledger_mood_check": {
          "name": "checkin_ledger_mood_check",
          "value": "\"checkin_ledger\".\"mood\" IN ('Ótimo', 'Bom', 'Neutro', 'Ruim', 'Muito ruim')"
        },
        "checkin_ledger_energy_check": {
          "name": "checkin_ledger_energy_check",
          "value": "\"checkin_ledger\".\"energy\" BETWEEN 1 AND 10"
        },
        "checkin_ledger_sleep_status_check": {
          "name": "checkin_ledger_sleep_status_check",
          "value": "\"checkin_ledger\".\"sleep_status\" IN ('Completo', 'Mínimo', 'Não feito', 'Não planejado')"
        },
        "checkin_ledger_training_status_check": {
          "name": "checkin_ledger_training_status_check",
          "value": "\"checkin_ledger\".\"training_status\" IN ('Completo', 'Mínimo', 'Não feito', 'Não planejado')"
        },
        "checkin_ledger_study_status_check": {
          "name": "checkin_ledger_study_status_check",
          "value": "\"checkin_ledger\".\"study_status\" IN ('Completo', 'Mínimo', 'Não feito', 'Não planejado')"
        },
        "checkin_ledger_audiobook_minutes_check": {
          "name": "checkin_ledger_audiobook_minutes_check",
          "value": "\"checkin_ledger\".\"audiobook_minutes\" BETWEEN 0 AND 600"
        },
        "checkin_ledger_dog_minutes_check": {
          "name": "checkin_ledger_dog_minutes_check",
          "value": "\"checkin_ledger\".\"dog_minutes\" BETWEEN 0 AND 300"
        },
        "checkin_ledger_music_minutes_check": {
          "name": "checkin_ledger_music_minutes_check",
          "value": "\"checkin_ledger\".\"music_minutes\" BETWEEN 0 AND 600"
        },
        "checkin_ledger_xp_day_check": {
          "name": "checkin_ledger_xp_day_check",
          "value": "\"checkin_ledger\".\"xp_day\" >= 0"
        },
        "checkin_ledger_origin_check": {
          "name": "checkin_ledger_origin_check",
          "value": "\"checkin_ledger\".\"origin\" IN ('live', 'legacy_import')"
        },
        "checkin_ledger_provenance_check": {
          "name": "checkin_ledger_provenance_check",
          "value": "(\n        \"checkin_ledger\".\"origin\" = 'live'\n        AND \"checkin_ledger\".\"legacy_notion_page_id\" IS NULL\n        AND \"checkin_ledger\".\"import_batch_id\" IS NULL\n      ) OR (\n        \"checkin_ledger\".\"origin\" = 'legacy_import'\n        AND \"checkin_ledger\".\"legacy_notion_page_id\" IS NOT NULL\n        AND \"checkin_ledger\".\"import_batch_id\" IS NOT NULL\n      )"
        }
      }
